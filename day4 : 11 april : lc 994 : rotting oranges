ps: m*n grid , each cell have 3 values 0 : empty , 1 : fresh orange , 2 for rotten orange. after each 1 minute the rotten orange rot its adjacent oranges

  if in the end there exist some fresh oranges then return -1 else return time taken to rot all the oranges.

  identify trick: think graph movement in grid dfs (mutlisource dfs queue)

  
class Solution {
public:
    int x[4] = {-1, 1, 0, 0};
    int y[4] = {0, 0, -1, 1};

    bool valid_move(int i, int j, int n, int m) {
        if (i < 0 || i >= n || j < 0 || j >= m) { // fixed bounds check
            return false;
        }
        return true;
    }

    int orangesRotting(vector<vector<int>>& grid) {
        int n = grid.size();
        int m = grid[0].size();
        queue<pair<int, int>> q;
        int fresh = 0, time = 0;

        for (int i = 0; i < n; i++) {
            for (int j = 0; j < m; j++) {
                if (grid[i][j] == 2) {
                    q.push({i, j});
                    grid[i][j] = -2; // mark rotten
                } else if (grid[i][j] == 1) {
                    fresh++;
                }
            }
        }

        while (!q.empty() && fresh > 0) {
            time++;
            int s = q.size();
            while (s--) {
                pair<int, int> p = q.front();
                q.pop();
                int r = p.first;
                int c = p.second;
                for (int k = 0; k < 4; k++) {
                    int row = r + x[k];
                    int col = c + y[k];
                    if (valid_move(row, col, n, m) &&
                        grid[row][col] == 1) { // fixed condition
                        grid[row][col] = -2;   // fixed assignment (= not ==)
                        fresh--;
                        q.push({row, col}); // enqueue newly rotten
                    }
                }
            }
        }

        if (fresh > 0) {
            return -1;
        }
        return time;
    }
};
