3. Tabulation :

2 ways forward (source to destination ) and backward (destination to source)

i. forward :

int uniquePaths(int m, int n) {
    vector<vector<int>> dp(n, vector<int>(m, 0));

    // Base case: first row and first column = 1
    for (int i = 0; i < n; i++) dp[i][0] = 1;
    for (int j = 0; j < m; j++) dp[0][j] = 1;

    // Fill table forward
    for (int i = 1; i < n; i++) {
        for (int j = 1; j < m; j++) {
            dp[i][j] = dp[i-1][j] + dp[i][j-1];
        }
    }

    return dp[n-1][m-1]; // destination
}

ii. backward :

int uniquePaths(int m, int n) {
    vector<vector<int>> dp(n+1, vector<int>(m+1, 0));

    // Base case: destination cell = 1
    dp[n-1][m-1] = 1;

    // Fill table backward
    for (int i = n-1; i >= 0; i--) {
        for (int j = m-1; j >= 0; j--) {
            if (i == n-1 && j == m-1) continue; // skip destination
            dp[i][j] = dp[i+1][j] + dp[i][j+1];
        }
    }

    return dp[0][0]; // start
}

