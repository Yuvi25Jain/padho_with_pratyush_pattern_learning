q16. lc 543: diameter of binary tree
  diameter : maximum distance between two leaf nodes.
    find height of tree from root. 


int helper(TreeNode* root , int &res) {
        if(root == NULL){
            return 0 ;
        }
        
        int left = helper(root->left,res);
        int right = helper(root->right,res);

        int sum = left + right ;
        res = max(res,sum);

        return 1 + max(left,right);

        
    }
    int diameterOfBinaryTree(TreeNode* root) {
    int res = 0;
    helper(root, res);
    return res;
    }



