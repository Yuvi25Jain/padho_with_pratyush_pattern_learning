  q17. lc 958 : check complete binary tree

    complete if leaf level order is node node NULL 
    not complete if it is node NULL node

  bool isCompleteTree(TreeNode* root) {
        if(root == NULL) return true ;
        bool nullfound = false;
        queue<TreeNode*> q;
        q.push(root);
        while(!q.empty()){
            TreeNode* t = q.front();
            q.pop();
            if(t == NULL){
                nullfound = true;
            }
            else{
                if(nullfound == true){
                    return false;
                }
                else{
                    q.push(t->left);
                    q.push(t->right);
                }
            }
        }
        return true;
        
    }

  
