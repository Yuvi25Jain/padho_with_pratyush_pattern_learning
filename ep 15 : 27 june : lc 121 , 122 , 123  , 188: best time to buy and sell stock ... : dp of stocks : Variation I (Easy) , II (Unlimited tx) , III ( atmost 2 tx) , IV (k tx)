int maxProfit(vector<int>& a, int k) {
    int n = a.size();
    int ans = 0;
    // For k=2 we had 4 loops, for k=3 we’d have 6 loops, etc.
    // General brute force = 2k nested loops.
    // Example for k=2 shown earlier.
    // For k=3:
    for(int i1=0;i1<n;i1++){
        for(int j1=i1+1;j1<n;j1++){
