//approach 4 : tabulation
int maxprofit(vector<int>&a){
    int n = a.size();
    int k = 2;
    
    vector<vector<int>>dp(n+1, vector<int>(k+1,0));
    for(int i = n-1 ; i>=0 ; i--){
        for(int moves = 1 ; moves<= k ;moves++){
            if(moves == 2){
                int c1 = dp[i+1][moves-1] - a[i];
                int c2 = dp[i+1][moves];
                dp[i][moves] = max(c1,c2);
            }
            else{
                int c1 = dp[i+1][moves-1] + a[i];
                int c2 = dp[i+1][moves];
                dp[i][moves] = max(c1,c2);
                
            }
        }
    }
    return dp[0][k];
}


int main()
{
    vector<int>a;
    input(a);
    output(a);
    cout<<endl;
    cout<<"Maximum profit possible: "<<maxprofit(a)<<endl;

    return 0;
}


