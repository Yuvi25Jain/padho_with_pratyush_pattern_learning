int helper_one(vector<int>&a, int n , int i , int k, vector<vector<int>>&dp){
    if (i == n) return 0;
    if(k == 0) return 0;

    if(dp[i][k] != -1) return dp[i][k];
    
    else if(k== 2){
        int c1 = helper_one(a,n,i+1,k-1,dp) - a[i];
        int c2 = helper_one(a,n,i+1,k,dp);
        return dp[i][k] = max(c1,c2);
    }
    else{
        int c1 = helper_one(a,n,i+1,2,dp) + a[i];
        int c2 = helper_one(a,n,i+1,k,dp);
        return dp[i][k] = max(c1,c2);
        
    }
}
 
int maxprofit_two(vector<int>&a){
    int n = a.size();
    int k = 2;
    vector<vector<int>>dp(n+1, vector<int>(k+1,-1));
    return helper_one(a,n,0,k,dp);
}

