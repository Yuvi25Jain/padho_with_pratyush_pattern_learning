BUY AND SELL STOCK VARIATION 2 (UNLIMITED TRANSACTION). 
buy - sell , buy - sell ✅
buy - buy - buy then sell - sell - sell ❌


earlier question after selling we decrement k to 0 ( k == 0) to end the transaction...  but this tym as soon as k == 1 reaches immediately pass 2 again instead of k-1 to create cycle.

just replace else wala block me 2 with k-1 in first selling choice :   int c1 = helper(a,n,i+1,2)+a[i];



//approach 1 : brute force : everytime price goes up , take profit , sum of all positive difference

int maxProfit(vector<int>& prices) 
{
        int n = prices.size();
        int profit = 0;

        for (int i = 1; i < n; i++) {
            if (prices[i] > prices[i-1]) {
                profit += prices[i] - prices[i-1]; // take every rise
            }
        }
        return profit;
}

//approach 2: recursion : just fix else wala block choice where we are selling the stock.
int helper(vector<int>&a , int n , int i , int k){
    if (i == n){
        return 0 ;
    }
    if (k == 0){
        return 0 ;
        
    }
    else if (k == 2){
        int c1 = helper(a,n,i+1,k-1)-a[i];
        int c2 = helper(a,n,i+1,k);
        
        return max(c1,c2);
    }
    else{
        int c1 = helper(a,n,i+1,2)+a[i];
        int c2 = helper(a,n,i+1,k);
        
        return max(c1,c2);
    }
}



int maxprofit_one(vector<int>&a){
    int n = a.size();
    int k = 2;
    int gain = helper(a,n,0,k);
    return gain;
}

