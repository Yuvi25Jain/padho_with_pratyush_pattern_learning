//approach 1 : brute force 
int maxProfit(vector<int>& a) { // k = 4 hence 4 variable i , j , k ,l
    int n = a.size();
    int ans = 0;
    for (int i = 0; i < n; i++) {
        for (int j = i+1; j < n; j++) {
            for (int k = j+1; k < n; k++) {
                for (int l = k+1; l < n; l++) {
                    int prf = (a[j]-a[i]) + (a[l]-a[k]);
                    ans = max(ans, prf);
                }
            }
        }
    }
    return ans;
}

