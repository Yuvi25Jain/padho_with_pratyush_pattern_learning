to represent graph in cpp there are two ways.
  1. adjacency matrix : drawback 
                   1.it takes high space (extra matrix) not that much useful.
                  2. Iteration over neighbours : to find neighbour of vertex scan entire row.
                    3. can't efficiently store multiple attributes like weight and direction without extra strucutre.
                    BEST FOR : DENSE GRAPH.


#include <bits/stdc++.h>
using namespace std;

// Function to build adjacency matrix
vector<vector<int>> buildMatrix(int n, int m) {
    vector<vector<int>> adj(n, vector<int>(n, 0)); // n x n matrix

    for (int edge = 0; edge < m; edge++) {
        int u, v;
        cin >> u >> v;
        adj[u][v] = 1;   // mark edge u->v
        adj[v][u] = 1;   // for undirected graph
    }
    return adj;
}

// Function to print adjacency matrix
void printMatrix(const vector<vector<int>>& adj) {
    int n = adj.size();
    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            cout << adj[i][j] << " ";
        }
        cout << endl;
    }
}

