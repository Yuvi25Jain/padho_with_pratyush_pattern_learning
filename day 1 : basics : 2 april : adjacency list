2. Adjacency list : 
overcomes the drawback of space efficiency by STORING ONLY EXISITNG EDGES. Space complexcity is o(n+m)  , much better for sparse graph.

allows fast neighbour access. directly list neighbos . it take o(degree(v))

works well for directed and undirected graph. 



#include <bits/stdc++.h>
using namespace std;

// Function to build adjacency list
vector<vector<int>> buildList(int n, int m) { //n vertex , m for edges.
    vector<vector<int>> adj(n); // adjacency list

    for (int edge = 0; edge < m; edge++) {
        int u, v;
        cin >> u >> v;
        adj[u].push_back(v);
        adj[v].push_back(u); // for undirected graph
    }
    return adj;
}

// Function to print adjacency list
void printList(const vector<vector<int>>& adj) {
    int n = adj.size();
    for (int i = 0; i < n; i++) {
        cout << i << " -> ";
        for (auto node : adj[i]) {
            cout << node << " ";
        }
        cout << endl;
    }
}
