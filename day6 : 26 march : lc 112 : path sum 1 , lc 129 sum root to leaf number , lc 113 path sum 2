q15. lc 113 path sum 2 . same as path sum 1 but we have to return the path in 2d array whose sum is equal to target.

  vector<vector<int>> pathSum(TreeNode* root, int targetSum,vector<int> diary = {} , int sum = 0) {
        vector<vector<int>> res;
        if (root == NULL) {
            return res; // return empty result
        }
        sum = sum + root->val;
        diary.push_back(root->val);
        if (root->left == NULL and root->right == NULL) {
            if (sum == targetSum) {
                res.push_back(diary);
                diary.pop_back();
               
            }
        } else {
            vector<vector<int>> leftRes = pathSum(root->left, targetSum, diary,sum);
             vector<vector<int>> rightRes =pathSum(root->right, targetSum, diary,sum);
            diary.pop_back();
            res.insert(res.end(), leftRes.begin(), leftRes.end());
            res.insert(res.end(), rightRes.begin(), rightRes.end());
           
        }
        return res;
    }
