#ps :

given an grid (m*n) consist of O and X only .
the boundary / edge O (first and last row , first and last col) dfs start , help it adjacent neighbour O ( diagonally not allowed) to be safe by converting them to # (a third different symbol)
  after the dfs there exist (non edge ) O which is surrounded by X and can't be save.

class Solution {
public:

    bool valid(int i , int j , int n , int m){
        //edge / not valid
        if(i<0 or i>=n or j<0 or j>=m){
            return false;
        }
        return true;
    }
    int x[4] = {1,-1,0,0};
    int y[4] = {0,0,1,-1};

    void dfs(vector<vector<char>>&a , int n , int m, int i , int j){
        a[i][j] = '#';
        //all 4 direction neighbours
        for(int k = 0 ; k<4 ; k++){
            int row = i + x[k];
            int col = j + y[k];

            if(valid(row,col, n,m) and a[row][col] == 'O'){
                dfs(a,n,m,row,col);
            }
        }
        return ;
    }

    void solve(vector<vector<char>>& board) {
        int n = board.size();
        int m = board[0].size();

        //start from edge : first row
        for(int j = 0 ; j<m ; j++){
            if(board[0][j] == 'O'){
                dfs(board, n,m , 0 , j);
            }
        }
        //last row
        for(int j = 0 ; j<m ; j++){
            if(board[n-1][j] == 'O'){
                dfs(board,n,m,n-1,j);
            }
        }
        //first col
        for(int i = 0 ; i<n ; i++){
            if(board[i][0] == 'O'){
                dfs(board,n,m,i,0);
            }
        }
        //last col (fixed: use m-1 instead of n-1)
        for(int i = 0 ; i<n ; i++){
            if(board[i][m-1] == 'O'){
                dfs(board,n,m,i,m-1);
            }
        }
        //traverse the whole grid
        for(int i = 0 ; i<n ; i++){
            for(int j = 0 ; j<m ; j++){
                if(board[i][j] == '#'){
                    board[i][j] = 'O';
                }
                else{
                    board[i][j] = 'X';
                }
            }
        }
        return ;
    } 
};
