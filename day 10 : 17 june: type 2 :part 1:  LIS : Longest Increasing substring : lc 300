2. Memoization:

to convert recursion into memoization first see recursion code check which 2 entities are being changed. 

here i = current , prev 

int recur(vector<int>& nums ,int n , int i , int prev , vector<vector<int>>& dp){ 
        if(i == n) return 0;              //let base case untouched

        if(dp[i][prev+1] != -1){
            return dp[i][prev+1];  //if dp[i][prev] if prev = -1 . we are accessing the invalid -1 position of prev and will throw segmentation error. so to fix these fix prev+1
        }

        if(prev == -1 or nums[i] > nums[prev]){
            int c1 = 1 + recur(nums,n,i+1,i,dp);
            int c2 = recur(nums,n,i+1, prev,dp);
            return dp[i][prev+1] = max(c1,c2);
        }
        return dp[i][prev+1] = recur(nums,n,i+1,prev,dp);
    }
    int lengthOfLIS(vector<int>& nums) {
        int n = nums.size();
        
        vector<vector<int>>dp(n, vector<int>(n+1,-1));
        return recur(nums,n, 0,-1,dp);

        
    }

explaination:

vector<vector<int>> dp(n, vector<int>(n+1, -1));
it will create 2d vector (like matrix) , 
n = number of rows each row corresponds to index i
  vector<int>(n+1,-1) means each rows itself is a vector of size(n+1) filled with -1
